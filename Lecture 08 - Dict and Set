#ამოცანა 2. სეტების ოპერაციები
ana = {'python', 'java', 'c', 'sql'}
nika = {'python', 'javascript', 'sql', 'go'}

print("operator:", ana | nika)
print("method:", ana.union(nika))

print("operator:", ana & nika)
print("method:", ana.intersection(nika))

print("operator:", ana - nika)
print("method:", ana.difference(nika))

#ამოცანა 3. კენჭისყრა

votes = ['Ana', 'Nika', 'Ana', 'Mari', 'Nika', 'Ana', 'Mari', 'Ana']

counts = {}
for name in votes:
    if name in counts:
        counts[name] += 1
    else:
        counts[name] = 1
        
for name, count in counts.items():
    print(f"{name}: {count}")

#ამოცანა 4. მაღაზიის მარაგი

inventory = {
    'laptop': {'price': 2500, 'quantity': 5},
    'mouse': {'price': 40, 'quantity': 0},
    'keyboard': {'price': 120, 'quantity': 12},
    'monitor': {'price': 800, 'quantity': 0},
}

total_value = 0
for i in inventory.values():
    total_value += i['price'] * i['quantity']
print("მარაგის საერთო ღირებულება:", total_value)

print("ამოწურული პროდუქტები:")
for name, i in inventory.items():
    if i['quantity'] == 0:
        print(name)

product = input("შეიყვანეთ პროდუქტის სახელი: ")
amount = int(input("შეიყვანეთ რაოდენობა: "))

if product not in inventory:
    print("პროდუქტი ვერ მოიძებნა")
elif inventory[product]['quantity'] < amount:
    print("მარაგი არასაკმარისია")
else:
    inventory[product]['quantity'] -= amount
    cost = inventory[product]['price'] * amount
    print(f"შეძენის ღირებულება: {cost}")

