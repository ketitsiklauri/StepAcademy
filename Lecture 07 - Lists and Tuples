#ხმოვნების დათვლა

text = input("Enter text: ")
count = 0
for char in text.lower():
    if char in "aeiou":
        count += 1
print("Vowels:", count)

#რიცხვების ჯამი (continue)

total = 0
count = 0
while True:
    user_input = input("Enter a number: ")

    if user_input == "stop":
        break

    number = int(user_input)
    if number < 0:
        print("Negative numbers are not allowed")
        continue
    total += number
    count += 1
print("Sum:", total)
print("Count:", count)


