#სიის შევსება (while)

numbers = []

while True:
    user_input = input("enter a number: ")

    if user_input == "stop":
        break

    numbers.append(int(user_input))

print("list:", numbers)
print("count:", len(numbers))

if numbers:
    print(f"first: {numbers[0]}, last: {numbers[-1]}")
    print("descending:", sorted(numbers, reverse=True))
else:
    print("The list is empty")
