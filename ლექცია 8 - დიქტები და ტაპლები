
#საყიდლების სია (დამატება და წაშლა)

shopping = ['milk', 'bread', 'eggs']
print(shopping)

shopping.append('cheese')
print(shopping)

shopping.insert(0, 'apples')
print(shopping)
shopping[-1] = 'butter'
print(shopping)

shopping.extend(['tea', 'coffee'])
print(shopping)

shopping.remove('bread')
print(shopping)

removed = shopping.pop(1)
print("Removed:", removed)
print(shopping)

 #ჩადგმული სია (მატრიცა)

